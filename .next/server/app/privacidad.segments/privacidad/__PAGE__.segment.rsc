6:["$","ul",null,{"children":[["$","li",null,{"children":"Entidades financieras para la formalización del pago del pedido."}],["$","li",null,{"children":"Empresas de logística, transporte y entrega de paquetes para el envío y entrega del pedido."}],["$","li",null,{"children":"Proveedores tecnológicos para el mantenimiento de la infraestructura del carrito de la compra."}],["$","li",null,{"children":"No se realizarán transferencias internacionales de datos."}]]}]
